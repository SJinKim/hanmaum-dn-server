# Copy to /opt/hanmaum-dn-server/.env.backup 1-2 weeks before production launch.
# Never commit the populated file.
BACKUP_ENABLED=false
BACKUP_ON_CALENDAR=Mon,Thu,Sat *-*-* 03:00:00
BACKUP_RETENTION_DAYS=30

# Restic Storage Box repository, for example:
# sftp:u123456@u123456.your-storagebox.de:/./hanmaum-restic
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/opt/hanmaum-dn-server/secrets/restic-password

POSTGRES_CONTAINER=hanmaumApp-db
POSTGRES_USER=
APP_DATABASE=
KEYCLOAK_DATABASE=hanmaum_keycloak_db
BACKUP_WORK_DIR=/var/backups/hanmaum-dn
